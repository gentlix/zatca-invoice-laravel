VITE_APP_NAME="${APP_NAME}"

# ============================================
# ZATCA Configuration (Based on Examples)
# ============================================

# ZATCA Environment: sandbox, simulation, or production
ZATCA_ENVIRONMENT=sandbox

# Organization Details (from examples/Certificates/GeneratorCertificate.php)
# Organization Identifier must be 15 digits, starting and ending with 3
ZATCA_ORG_IDENTIFIER=399999999900003

# Organization Name (from examples - Arabic name used: مؤسسة وقت الاستجابة)
# You can use: مؤسسة وقت الاستجابة or "Latency" (as in invoice examples)
ZATCA_ORG_NAME=Latency

# Organizational Unit (quoted because it contains spaces)
ZATCA_ORG_UNIT="IT Department"

# Organization Address (quoted because it contains spaces)
ZATCA_ORG_ADDRESS="1234 Main St, Riyadh"

# Country Code (must be 2 characters)
ZATCA_ORG_COUNTRY=SA

# Business Category
ZATCA_BUSINESS_CATEGORY=Technology

# Certificate Details (from examples/Certificates/GeneratorCertificate.php)
# Solution Name: The solution provider name
ZATCA_SOLUTION_NAME=POS

# Model: The model of the unit the stamp is being generated for
ZATCA_MODEL=A1

# Serial Number: If you have multiple devices each should have a unique serial number
ZATCA_SERIAL_NUMBER=98765

# Invoice Type: Four digits, each digit acting as a bool
# The order is: Standard Invoice, Simplified, future use, future use
# 1000 = Simplified only
# 1100 = Standard + Simplified (recommended)
ZATCA_INVOICE_TYPE=1000

# Production Mode: true = Production | false = Testing
ZATCA_PRODUCTION=false

# API Settings
ZATCA_API_TIMEOUT=30
ZATCA_API_RETRY=3

# OTP Code (for requesting compliance certificate)
# Get this from ZATCA portal after uploading CSR
ZATCA_OTP=123123


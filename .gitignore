# Laravel Storage (keep directory structure)
/storage/app/*
!/storage/app/.gitkeep
!/storage/app/certificates/.gitkeep
!/storage/app/qr_codes/.gitkeep
!/storage/app/invoices/.gitkeep

# ZATCA Specific - Sensitive Certificate Files
/storage/app/certificates/*.pem
/storage/app/certificates/*.key
/storage/app/certificates/*.crt
/storage/app/certificates/*.csr
/storage/app/certificates/*.pfx
/storage/app/certificates/*.p12
!/storage/app/certificates/.gitkeep

# ZATCA Generated Files
/storage/app/qr_codes/*
!/storage/app/qr_codes/.gitkeep
/storage/app/invoices/*
!/storage/app/invoices/.gitkeep

# Logs
/storage/logs/*
!/storage/logs/.gitkeep
*.log

# Temporary Files
/storage/app/temp_openssl.cnf
*.tmp
*.temp
*.swp
*.swo
*~


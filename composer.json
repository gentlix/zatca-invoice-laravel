{
    "name": "laravel/zatca-laravel",
    "type": "project",
    "description": "Laravel application with ZATCA integration",
    "keywords": ["laravel", "zatca"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "guzzlehttp/guzzle": "^7.10",
        "laravel/framework": "^11.0",
        "laravel/tinker": "^2.9",
        "sevaske/php-zatca-xml": "^3.4",
        "simplesoftwareio/simple-qrcode": "^4.2",
        "symfony/polyfill-ctype": "^1.33",
        "symfony/polyfill-intl-grapheme": "^1.33",
        "symfony/polyfill-intl-idn": "^1.33",
        "symfony/polyfill-intl-normalizer": "^1.33",
        "symfony/polyfill-mbstring": "^1.33",
        "symfony/polyfill-php80": "^1.33",
        "symfony/polyfill-php83": "^1.33",
        "symfony/polyfill-uuid": "^1.33"
    },
    "require-dev": {
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\""
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
